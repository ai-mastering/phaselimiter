{
  "name": "phaselimiter",
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile",
    "target": "development",
    "options": [
      "--platform=linux/amd64"
    ]
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "remoteUser": "root",
  "runArgs": [
    "--platform=linux/amd64"
  ]
}
