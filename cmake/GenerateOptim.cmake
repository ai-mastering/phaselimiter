# Equivalent to deps/optim/configure --header-only-version, without Bash/sed
# or writes into the submodule. Only the four implementation directories need
# their include guard opened and the inline implementation appended.
if(NOT OPTIM_SOURCE_DIR OR NOT OPTIM_OUTPUT_DIR)
  message(FATAL_ERROR "OPTIM_SOURCE_DIR and OPTIM_OUTPUT_DIR are required")
endif()
file(REMOVE_RECURSE "${OPTIM_OUTPUT_DIR}")
file(MAKE_DIRECTORY "${OPTIM_OUTPUT_DIR}")
file(COPY "${OPTIM_SOURCE_DIR}/include/" DESTINATION "${OPTIM_OUTPUT_DIR}")
foreach(directory IN ITEMS constrained line_search unconstrained zeros)
  file(GLOB headers "${OPTIM_SOURCE_DIR}/include/${directory}/*.hpp")
  foreach(header IN LISTS headers)
    get_filename_component(name "${header}" NAME_WE)
    file(READ "${header}" declaration)
    string(REPLACE "#endif" "//\n" declaration "${declaration}")
    file(READ "${OPTIM_SOURCE_DIR}/src/${directory}/${name}.cpp" implementation)
    string(FIND "${implementation}" "[OPTIM_BEGIN]" marker)
    if(marker EQUAL -1)
      message(FATAL_ERROR "Missing [OPTIM_BEGIN] in ${directory}/${name}.cpp")
    endif()
    string(SUBSTRING "${implementation}" ${marker} -1 implementation)
    string(FIND "${implementation}" "\n" line_end)
    math(EXPR implementation_start "${line_end} + 1")
    string(SUBSTRING "${implementation}" ${implementation_start} -1 implementation)
    string(REPLACE "optimlib_inline" "inline" implementation "${implementation}")
    string(REPLACE "optim::" "" implementation "${implementation}")
    file(WRITE "${OPTIM_OUTPUT_DIR}/${directory}/${name}.hpp"
      "${declaration}${implementation}\n#endif\n")
  endforeach()
endforeach()
