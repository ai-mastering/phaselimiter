execute_process(COMMAND "${TOOL}" "--input=${INPUT}"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "snd_file_info failed (${status}): ${error}")
endif()
foreach(field IN ITEMS channels frames samplerate)
  string(JSON actual ERROR_VARIABLE error GET "${output}" "${field}")
  if(error)
    message(FATAL_ERROR "Invalid snd_file_info JSON: ${error}")
  endif()
  if(field STREQUAL channels)
    set(expected 2)
  elseif(field STREQUAL frames)
    set(expected 280049)
  else()
    set(expected 44100)
  endif()
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "${field}: expected ${expected}, got ${actual}")
  endif()
endforeach()
